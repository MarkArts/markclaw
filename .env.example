# Claude authentication — requires OAuth (run `claude /login` first)
# The host's ~/.claude/.credentials.json is mounted into agent containers.
# API keys are NOT supported — agents need full Claude Code CLI auth.

# Model (optional, defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Slack Bot — optional (Socket Mode). Without Slack, use the web UI.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=U07XXXXXXXX

# Web UI
WEB_UI_USER=admin
WEB_UI_PASS=changeminprod
# GITHUB_ORG=your-org
# JIRA_SITE=https://your-org.atlassian.net

# GitHub Stacked PRs (gh-stack) — in private beta. When true, the gh-stack skill
# is exposed to agents so they can build stacked PRs with `gh stack`. Leave false
# until the feature is enabled for your repos. Default: false.
# GH_STACK_ENABLED=false
